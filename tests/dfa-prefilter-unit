. "${srcdir=.}/init.sh"; path_prepend_ ../src

prog="$abs_top_builddir/src/dfa-prefilter-test"
if test ! -x "$prog"; then
  ${MAKE:-make} -C "$abs_top_builddir/src" dfa-prefilter-test >&2 \
    || framework_failure_
fi

fail=0

LC_ALL=C "$prog" || fail=1

"$prog" --utf8
rc=$?
if test $rc -ne 0 && test $rc -ne 77; then
  fail=1
fi

Exit $fail
