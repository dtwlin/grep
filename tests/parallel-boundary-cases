# Disjoint matches (lines 1 and 4 with -C 1: separated by --)
GREP_THREADS=1 grep -C 1 -E 'kw_0001|kw_0064' in_kw_data > exp_cdis 2>&1
for t in 2 4 8; do
  GREP_THREADS=$t grep -C 1 -E 'kw_0001|kw_0064' in_kw_data > "out_cdis_$t" 2>&1
