# Custom group separator and no group separator
GREP_THREADS=1 grep -C 1 --group-separator='====' -E 'kw_0001|kw_0064' in_kw_data > exp_csep 2>&1
for t in 2 4 8; do
  GREP_THREADS=$t grep -C 1 --group-separator='====' -E 'kw_0001|kw_0064' in_kw_data > "out_csep_$t" 2>&1
