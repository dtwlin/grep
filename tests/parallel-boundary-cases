# =========================================================================
mkdir -p dir_deep/a/b/c/d/e/f/g/h/i/j || framework_failure_
echo 'deep_target_token' > dir_deep/a/b/c/d/e/f/g/h/i/j/deep.txt || framework_failure_
echo 'target_in_space' > 'dir_deep/file with space.txt' || framework_failure_

# Multi-file mixed arguments (empty, nonl, regular, binary)
GREP_THREADS=1 grep 'target' in_empty in_nonl in_kw_data in_bin_mid > exp_multi 2>&1
for t in 2 4 8; do
