GREP_THREADS=1 grep '$' in_kw_data > exp_anch_dollar 2>&1
for t in 2 4 8; do
  GREP_THREADS=$t grep '$' in_kw_data > "out_anch_dollar_$t" 2>&1
  compare exp_anch_dollar "out_anch_dollar_$t" || fail=1
done

# Word boundary with empty pattern matches lines with word boundaries
GREP_THREADS=1 grep -w '' in_kw_data > exp_w_emp 2>&1
for t in 2 4 8; do
  GREP_THREADS=$t grep -w '' in_kw_data > "out_w_emp_$t" 2>&1
  compare exp_w_emp "out_w_emp_$t" || fail=1
