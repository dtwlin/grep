# =========================================================================
# -m 0 exits 1 with no output
GREP_THREADS=1 grep -m 0 'kw_0001' in_kw_data > out_m0 2>&1
test $? -eq 1 || fail=1
test ! -s out_m0 || fail=1

# -m 1 with count -c
GREP_THREADS=1 grep -m 1 -c 'line' in_kw_data > exp_m1c 2>&1
for t in 2 4 8; do
  GREP_THREADS=$t grep -m 1 -c 'line' in_kw_data > "out_m1c_$t" 2>&1
