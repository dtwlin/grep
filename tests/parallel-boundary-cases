# STDIN without trailing newline
printf 'pipe_nonl_target' | GREP_THREADS=1 grep 'pipe_nonl_target' > exp_sin_nonl 2>&1
for t in 2 4 8; do
  printf 'pipe_nonl_target' | GREP_THREADS=$t grep 'pipe_nonl_target' > "out_sin_nonl_$t" 2>&1
  compare exp_sin_nonl "out_sin_nonl_$t" || fail=1
done

# STDIN null data (-z)
printf 'rec1\0rec2_pipe_target\0rec3\0' | GREP_THREADS=1 grep -z 'rec2_pipe_target' > exp_sin_z 2>&1
for t in 2 4 8; do
  printf 'rec1\0rec2_pipe_target\0rec3\0' | GREP_THREADS=$t grep -z 'rec2_pipe_target' > "out_sin_z_$t" 2>&1
  compare exp_sin_z "out_sin_z_$t" || fail=1
done

# STDIN -m 1 count
printf 'line1\nline2\nline3\n' | GREP_THREADS=1 grep -m 1 -c 'line' > exp_sin_m1c 2>&1
for t in 2 4 8; do
  printf 'line1\nline2\nline3\n' | GREP_THREADS=$t grep -m 1 -c 'line' > "out_sin_m1c_$t" 2>&1
  compare exp_sin_m1c "out_sin_m1c_$t" || fail=1
done

Exit $fail
