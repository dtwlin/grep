. "${srcdir=.}/init.sh"; path_prepend_ ../src

fail=0

# Helper: compare GREP_THREADS=1 against GREP_THREADS=2,4 for stdout, stderr, and exit code.
check_threads ()
{
  tag=$1
  shift
  GREP_THREADS=1 "$@" > "exp_$tag" 2> "experr_$tag"
  rc_exp=$?
  test "$rc_exp" -le 2 || { fail=1; echo "bad rc_exp=$rc_exp: $tag" >&2; }
  for t in 2 4; do
    GREP_THREADS=$t "$@" > "out_${tag}_$t" 2> "outerr_${tag}_$t"
    rc_got=$?
    test "$rc_got" -eq "$rc_exp" || { fail=1; echo "rc mismatch: $tag t=$t ($rc_got vs $rc_exp)" >&2; }
    compare "exp_$tag" "out_${tag}_$t" || fail=1
    compare "experr_$tag" "outerr_${tag}_$t" || fail=1
  done
}

# Detect UTF-8 and non-UTF-8 multibyte locales if installed
u8_loc=""
if test "${LOCALE_FR_UTF8:-none}" != "none"; then
  u8_loc="$LOCALE_FR_UTF8"
elif locale -a 2>/dev/null | grep -E '^en_US\.(utf8|UTF-8)$' >/dev/null 2>&1; then
  u8_loc="en_US.UTF-8"
elif locale -a 2>/dev/null | grep -E '^C\.(utf8|UTF-8)$' >/dev/null 2>&1; then
  u8_loc="C.UTF-8"
fi

gb_loc=""
for cand in zh_CN.gb18030 zh_CN.GB18030 zh_CN.gbk zh_CN.GBK; do
  if locale -a 2>/dev/null | grep -F -x "$cand" >/dev/null 2>&1; then
    gb_loc="$cand"
    break
  fi
done

# -------------------------------------------------------------------------
# 1. searchutils.c & kwsearch.c: Multibyte, Word-Boundary & UTF-8 Quirk Paths
# -------------------------------------------------------------------------
# 1a. Non-UTF-8 multibyte (GB18030): invalid multibyte before match (mb_goback clen < 0)
# and trail-byte false match (\x81\x41 where 0x41 is 'A').
if test -n "$gb_loc"; then
  printf '\377ABC\n' > gb_invalid.txt || framework_failure_
  LC_ALL="$gb_loc" grep -a -F ABC gb_invalid.txt > out_gb_inv || fail=1
  compare gb_invalid.txt out_gb_inv || fail=1

  # \201A is a single 2-byte GB18030 char; only the second 'A' is a real 'A'.
  printf '\201AA\n\201AB\n' > gb_trail.txt || framework_failure_
  printf '\201AA\n' > exp_gb_trail || framework_failure_
  LC_ALL="$gb_loc" grep -F A gb_trail.txt > out_gb_trail || fail=1
  compare exp_gb_trail out_gb_trail || fail=1

  # EGexecute exact_kwset_match in non-UTF-8 multibyte locale on line 2 (mb_start < beg)
  printf 'line1_no_match\nABC_on_line2\n' > gb_eg.txt || framework_failure_
  printf 'ABC_on_line2\n' > exp_gb_eg || framework_failure_
  LC_ALL="$gb_loc" grep -E '^ABC' gb_eg.txt > out_gb_eg || fail=1
  compare exp_gb_eg out_gb_eg || fail=1

  if (grep -P --version) >/dev/null 2>&1; then
    returns_ 2 env LC_ALL="$gb_loc" grep -P abc gb_eg.txt >/dev/null 2>&1 || fail=1
  fi
fi

# 1b. UTF-8 wordchars_count hitting a valid multibyte non-word char (em-dash \342\200\224),
# Fexecute_core shorter keyword fallback (-F -w -e foo -e foo-bar on foo-barbaz),
# and Fexecute_with_utf8_quirk / find_utf8_icase_quirk (both <32B, >64B, >1024B lines).
if test -n "$u8_loc"; then
  printf 'foob\342\200\224foo\n' > u8_word.txt || framework_failure_
  LC_ALL="$u8_loc" grep -F -w foo u8_word.txt > out_u8_word || fail=1
  compare u8_word.txt out_u8_word || fail=1

  printf 'foo-barbaz\n' > u8_shorter.txt || framework_failure_
  LC_ALL="$u8_loc" grep -F -w -e foo -e foo-bar u8_shorter.txt > out_u8_shorter || fail=1
  compare u8_shorter.txt out_u8_shorter || fail=1

  printf 'foo\n' > exp_u8_shorter_o || framework_failure_
  LC_ALL="$u8_loc" grep -F -w -o -e foo -e foo-bar u8_shorter.txt > out_u8_shorter_o || fail=1
  compare exp_u8_shorter_o out_u8_shorter_o || fail=1

  # Multi-line buffer: line 1 has dotless-i (no match), line 2 has ASCII match before line 3 quirk
  printf 'no_match_\304\261_line1\nplain_ascii_isi_match_line2\ntrailing_\304\261_line3\n' > u8_quirk_ml.txt || framework_failure_
  printf 'plain_ascii_isi_match_line2\n' > exp_u8_quirk_ml || framework_failure_
  LC_ALL="$u8_loc" grep -F -i isi u8_quirk_ml.txt > out_u8_quirk_ml || fail=1
  compare exp_u8_quirk_ml out_u8_quirk_ml || fail=1

  # Multi-line buffer: line 1 has quirk (no match), line 2 has no quirk and no match (returns -1)
  printf 'no_match_\304\261_line1\nplain_ascii_nomatch_line2\n' > u8_quirk_none.txt || framework_failure_
  returns_ 1 env LC_ALL="$u8_loc" grep -F -i isi u8_quirk_none.txt >/dev/null || fail=1

  # AVX2 (>32B) and heap-allocated (>1024B) lines containing both dotless-i (\304\261) and long-s (\305\277)
  awk 'BEGIN {
    pad = ""
    for (i = 0; i < 60; i++) pad = pad "xxxxxxxxxxxxxxxxxxxx"
    printf "%s_no_match_\304\261_\305\277_%s\n", pad, pad
    printf "%s_match_i\305\277\304\261_target_%s\n", pad, pad
  }' > u8_quirk_long.txt || framework_failure_
  LC_ALL="$u8_loc" grep -F -i isi u8_quirk_long.txt > out_u8_quirk_long || fail=1
  test "$(wc -l < out_u8_quirk_long)" -eq 1 || fail=1

  # Multiple -o matches on a single line containing a quirk byte (start_ptr > line_beg)
  printf 'xx_\304\261s\304\261_mid_i\305\277i_end\n' > u8_quirk_multi_o.txt || framework_failure_
  printf '\304\261s\304\261\ni\305\277i\n' > exp_u8_quirk_multi_o || framework_failure_
  LC_ALL="$u8_loc" grep -F -i -o isi u8_quirk_multi_o.txt > out_u8_quirk_multi_o || fail=1
  compare exp_u8_quirk_multi_o out_u8_quirk_multi_o || fail=1
fi

# -------------------------------------------------------------------------
# 2. pcresearch.c: Execution Limits & find_must_literal Parser Coverage
# -------------------------------------------------------------------------
if (grep -P --version) >/dev/null 2>&1; then
  # PCRE2_ERROR_MATCHLIMIT, PCRE2_ERROR_RECURSELOOP, PCRE2_ERROR_HEAPLIMIT
  printf 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab\n' > pcre_lim.txt || framework_failure_
  returns_ 2 grep -P '(*NO_JIT)(*LIMIT_MATCH=3)((a+)*)+$' pcre_lim.txt >/dev/null 2>&1 || fail=1
  returns_ 2 grep -P '(*NO_JIT)((?1))' pcre_lim.txt >/dev/null 2>&1 || fail=1
  returns_ 2 grep -P '(*NO_JIT)(*LIMIT_HEAP=1)((a+)*)+$' pcre_lim.txt >/dev/null 2>&1 || fail=1

  # Octal escapes \o{...}, \101, backref \1, leading-] character classes, nested groups/verbs/quantifiers
  printf 'Abcde\n]bcde\nxbcde\nabbcde\nabcde\nabbbcde\nfoo(bar)\n' > pcre_must.txt || framework_failure_
  grep -P '\o{101}bcde' pcre_must.txt >/dev/null || fail=1
  grep -P '\101bcde' pcre_must.txt >/dev/null || fail=1
  grep -P '(a)\1bcde' pcre_must.txt >/dev/null && fail=1
  grep -P '[]a]bcde' pcre_must.txt >/dev/null || fail=1
  grep -P '[^]a]bcde' pcre_must.txt >/dev/null || fail=1
  grep -P '((a(*ACCEPT)))bcde' pcre_must.txt >/dev/null || fail=1
  grep -P '((?:ab))bcde' pcre_must.txt >/dev/null || fail=1
  grep -P '((?<=ab))bcde' pcre_must.txt >/dev/null || fail=1
  grep -P '(?>ab)cde' pcre_must.txt >/dev/null || fail=1
  grep -P '(?=ab)abcde' pcre_must.txt >/dev/null || fail=1
  grep -P '(?<!xy)abcde' pcre_must.txt >/dev/null || fail=1
  grep -P '((?!xy))bcde' pcre_must.txt >/dev/null || fail=1
  grep -P 'abcde|xyz' pcre_must.txt >/dev/null || fail=1
  grep -P '(?:a|b)bcde' pcre_must.txt >/dev/null || fail=1
  grep -P '([a-z]\w)bcde' pcre_must.txt >/dev/null || fail=1
  grep -P '(?i)abcde' pcre_must.txt >/dev/null || fail=1
  grep -P '(ab){1,2}bcde' pcre_must.txt >/dev/null || fail=1
  grep -P 'ab{2,3}cde' pcre_must.txt >/dev/null || fail=1
  grep -P '.{1,2}cde' pcre_must.txt >/dev/null || fail=1
  grep -P 'abc+de' pcre_must.txt >/dev/null || fail=1
  grep -P 'foo\(bar\)' pcre_must.txt >/dev/null || fail=1
  grep -P 'foo\(?bar\)' pcre_must.txt >/dev/null || fail=1
  grep -P -w 'abcde' pcre_must.txt >/dev/null || fail=1
  grep -P -x 'abcde' pcre_must.txt >/dev/null || fail=1
fi

