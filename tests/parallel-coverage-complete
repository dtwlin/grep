# -------------------------------------------------------------------------
# 5. grep.c: exact_stdout Deferred Self-File Search & Large Write Tracking
# -------------------------------------------------------------------------
# Create a file with a single > 70 KiB matching line (exceeding BIG_WRITE_MIN = 64 KiB)
awk 'BEGIN {
  printf "EXACT_STDOUT_TOKEN_"
  for (i = 1; i <= 7200; i++)
    printf "0123456789"
  printf "\n"
}' > big_match.txt || framework_failure_

# 5a. ROB deferred self-file
for t in 1 2 4; do
  printf 'EXACT_STDOUT_TOKEN initial line\n' > self_rob.txt || framework_failure_
  GREP_THREADS=$t grep -m 1 EXACT_STDOUT_TOKEN self_rob.txt big_match.txt >> self_rob.txt || fail=1
  cp self_rob.txt "self_rob_$t.txt" || framework_failure_
done
compare self_rob_1.txt self_rob_2.txt || fail=1
compare self_rob_1.txt self_rob_4.txt || fail=1

# 5b. Walk deferred self-file (-r over a directory containing 01_big.txt with a >64 KiB single line + 02_out.txt)
for t in 1 2 4; do
  rm -rf defer_dir && mkdir -p defer_dir || framework_failure_
  cp big_match.txt defer_dir/01_big.txt || framework_failure_
  printf 'EXACT_STDOUT_TOKEN in deferred output\n' > defer_dir/02_out.txt || framework_failure_
  GREP_THREADS=$t grep -r -m 1 EXACT_STDOUT_TOKEN defer_dir >> defer_dir/02_out.txt || fail=1
  cp defer_dir/02_out.txt "walk_defer_$t.txt" || framework_failure_
done
